+    /// Finds the zero-length positions where `is_boundary(previous, current)`
+    /// holds, e.g. word starts or line starts. The label covers the character
+    /// at the boundary.
+    fn find_flash_boundaries(
+        buffer: &MultiBufferSnapshot,
+        start_offset: MultiBufferOffset,
+        end_offset: MultiBufferOffset,
+        is_boundary: impl Fn(Option<char>, char) -> bool,
+    ) -> Vec<FlashMatch> {
+        let mut matches = Vec::new();
+        let mut previous = buffer.reversed_chars_at(start_offset).next();
+        let mut chunk_start = start_offset;
+        for chunk in buffer.text_for_range(start_offset..end_offset) {
+            for (index, ch) in chunk.char_indices() {
+                if is_boundary(previous, ch) {
+                    let offset = chunk_start + index;
+                    matches.push(FlashMatch {
+                        range: offset..offset,
+                        next_char: Some(ch),
+                    });
+                }
+                previous = Some(ch);
+            }
+            chunk_start = chunk_start + chunk.len();
+        }
+        matches
+    }
+
+    /// Over the match cap, keeps the matches closest to the cursor, in buffer
+    /// order.
+    fn nearest_flash_matches(
+        mut matches: Vec<FlashMatch>,
+        cursor_offset: MultiBufferOffset,
+    ) -> Vec<FlashMatch> {
+        if matches.len() <= FLASH_JUMP_MAX_MATCHES {
+            return matches;
+        }
+        matches.sort_by_key(|flash_match| flash_match.range.start.0.abs_diff(cursor_offset.0));
+        matches.truncate(FLASH_JUMP_MAX_MATCHES);
+        matches.sort_by_key(|flash_match| flash_match.range.start);
+        matches
+    }
