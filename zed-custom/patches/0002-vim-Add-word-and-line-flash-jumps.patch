+/// Which positions a flash jump labels.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FlashMode {
+    /// Matches of the typed pattern.
+    Pattern,
+    /// Word starts, narrowed to words that begin with the typed pattern.
+    Word,
+    /// Line starts; there is no pattern, so every key is a label.
+    Line,
+}
