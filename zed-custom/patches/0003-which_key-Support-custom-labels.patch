+                .iter()
+                .flatten()
+                .filter_map(|(sequence, label)| {
+                    Some((canonical_sequence(sequence)?, label.clone().into()))
+                })
+                .collect(),
         }
     }
 }
+
+/// Re-renders a keymap-style sequence the way `sequence_key` renders bound
+/// keystrokes, so `"space  g"` and `"space g"` find the same label. Invalid
+/// sequences are dropped, like invalid keymap entries.
+fn canonical_sequence(sequence: &str) -> Option<String> {
+    let keystrokes = sequence
+        .split_whitespace()
+        .map(|keystroke| Keystroke::parse(keystroke).ok())
+        .collect::<Option<Vec<_>>>()?;
+    Some(
+        keystrokes
+            .iter()
+            .map(Keystroke::unparse)
+            .collect::<Vec<_>>()
+            .join(" "),
+    )
+}
