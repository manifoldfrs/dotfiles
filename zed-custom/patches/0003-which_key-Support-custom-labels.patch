 pub(crate) struct PendingBinding {
+    /// The binding's own keystrokes for the input typed so far, as written in
+    /// the keymap, used to look up custom labels.
+    pub(crate) typed_keystrokes: Vec<KeybindingKeystroke>,
     pub(crate) remaining_keystrokes: Vec<KeybindingKeystroke>,
     pub(crate) action_name: SharedString,
 }
 
+/// Renders keystrokes the way `WhichKeySettings` canonicalizes label keys.
+pub(crate) fn sequence_key<'a>(
+    keystrokes: impl IntoIterator<Item = &'a KeybindingKeystroke>,
+) -> String {
+    keystrokes
+        .into_iter()
+        .map(|keystroke| keystroke.inner().unparse())
+        .collect::<Vec<_>>()
+        .join(" ")
+}
