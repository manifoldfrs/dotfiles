{
  "guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/agy-pretool-guardrail.sh bash",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/agy-pretool-guardrail.sh edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/agy-pretool-guardrail.sh edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/agy-pretool-guardrail.sh edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/agy-pretool-guardrail.sh edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/config/hooks/agy-pretool-guardrail.sh edit",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
