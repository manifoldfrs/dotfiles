#!/bin/bash
set -e

# Finish an OAuth sign-in started on a remote host whose callback went to this Mac's localhost.
# After approving in the browser, copy the failed http://127.0.0.1:<port>/... address and run this;
# it requests that address on the remote host, where the waiting login listens.
# Run on the remote host itself, it requests the address there directly.
# Usage: agentbox-auth [callback-url] [host]   (url defaults to the clipboard, host to agentbox)

url="$1"
host="${2:-agentbox}"

if [[ -z $url ]]; then
    if ! command -v pbpaste >/dev/null 2>&1; then
        printf "agentbox-auth: no clipboard here; pass the address in single quotes: agentbox-auth '<address>'\n" >&2
        exit 1
    fi
    url="$(pbpaste)"
fi
url="${url//[$'\t\r\n ']/}"

if [[ ! $url =~ ^http://(127\.0\.0\.1|localhost|\[::1\]):[0-9]+/ ]]; then
    printf 'agentbox-auth: expected a http://127.0.0.1:<port>/... callback address, from the argument or the clipboard\n' >&2
    exit 1
fi

if [[ $url != *state=* ]]; then
    printf "agentbox-auth: the address has no state= part; if you passed it unquoted, the shell cut it at '&', so wrap it in single quotes\n" >&2
    exit 1
fi

if [[ $(uname) != Darwin ]]; then
    host="$(hostname)"
    status="$(curl -sS -o /dev/null -w '%{http_code}' "$url" 2>&1)" || {
        printf 'agentbox-auth: could not reach the login here: %s\n' "$status" >&2
        exit 1
    }
# The address carries a one-time code, so it travels on stdin rather than in the remote command line.
elif ! status="$(printf '%s\n' "$url" | ssh "$host" 'read -r url; curl -sS -o /dev/null -w "%{http_code}" "$url"' 2>&1)"; then
    printf 'agentbox-auth: could not reach the login on %s: %s\n' "$host" "$status" >&2
    exit 1
fi

if [[ $status != 2* && $status != 3* ]]; then
    printf 'agentbox-auth: the login on %s answered HTTP %s; it may have timed out, so start it again\n' "$host" "$status" >&2
    exit 1
fi

printf 'Delivered the sign-in to %s (HTTP %s).\n' "$host" "$status"
