{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/block-dangerous-bash.sh",
            "timeout": 30,
            "statusMessage": "Checking Bash command"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/block-generated-edits.sh",
            "timeout": 30,
            "statusMessage": "Checking generated-file policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(exa__web_fetch_exa|exa__web_search_exa|exa__web_search_advanced_exa|Ref__ref_read_url|Ref__ref_search_documentation)$",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node ~/.codex/hooks/jev-screen.ts",
            "timeout": 120,
            "statusMessage": "Screening web result with Jev"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node ~/.codex/hooks/jev-coding.ts",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node ~/.codex/hooks/jev-coding.ts",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/plannotator",
            "timeout": 345600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node ~/.codex/hooks/jev-coding.ts",
            "timeout": 180,
            "statusMessage": "Auditing edit scope with Jev"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
