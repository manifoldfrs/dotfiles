ble-sabbrev 'gpoat=git push origin --all && git push origin --tags'
ble-sabbrev 'ggpnp=git pull origin $(git_current_branch) && git push origin $(git_current_branch)'
ble-sabbrev 'gr=git remote -vv'
ble-sabbrev 'gra=git remote add'
ble-sabbrev 'grb=git rebase'
ble-sabbrev 'grba=git rebase --abort'
ble-sabbrev 'grbc=git rebase --continue'
ble-sabbrev 'grbi=git rebase --interactive'
ble-sabbrev 'grbm=git rebase $(git_default_branch)'
ble-sabbrev 'grbmi=git rebase $(git_default_branch) --interactive'
ble-sabbrev 'grbmia=git rebase $(git_default_branch) --interactive --autosquash'
ble-sabbrev 'grbom=git fetch origin $(git_default_branch) && git rebase FETCH_HEAD'
ble-sabbrev 'grbomi=git fetch origin $(git_default_branch) && git rebase FETCH_HEAD --interactive'
ble-sabbrev 'grbomia=git fetch origin $(git_default_branch) && git rebase FETCH_HEAD --interactive --autosquash'
ble-sabbrev 'grbd=git rebase develop'
ble-sabbrev 'grbdi=git rebase develop --interactive'
ble-sabbrev 'grbdia=git rebase develop --interactive --autosquash'
ble-sabbrev 'grbs=git rebase --skip'
ble-sabbrev 'ggu=git pull --rebase origin $(git_current_branch)'
ble-sabbrev 'grev=git revert'
ble-sabbrev 'grh=git reset'
ble-sabbrev 'grhh=git reset --hard'
ble-sabbrev 'grhpa=git reset --patch'
ble-sabbrev 'grm=git rm'
ble-sabbrev 'grmc=git rm --cached'
ble-sabbrev 'grmv=git remote rename'
ble-sabbrev 'grpo=git remote prune origin'
ble-sabbrev 'grrm=git remote remove'
ble-sabbrev 'grs=git restore'
ble-sabbrev 'grset=git remote set-url'
ble-sabbrev 'grss=git restore --source'
ble-sabbrev 'grst=git restore --staged'
ble-sabbrev 'grup=git remote update'
ble-sabbrev 'grv=git remote -v'
ble-sabbrev 'gsh=git show'
ble-sabbrev 'gsd=git svn dcommit'
ble-sabbrev 'gsr=git svn rebase'
ble-sabbrev 'gsb=git status -sb'
