ble-sabbrev 'gsts=git stash show --text'
ble-sabbrev 'gsu=git submodule update'
ble-sabbrev 'gsur=git submodule update --recursive'
ble-sabbrev 'gsuri=git submodule update --recursive --init'
ble-sabbrev 'gts=git tag -s'
ble-sabbrev 'gtv=git tag | sort -V'
ble-sabbrev 'gsw=git switch'
ble-sabbrev 'gswc=git switch --create'
ble-sabbrev 'gunignore=git update-index --no-assume-unchanged'
ble-sabbrev 'gup=git pull --rebase'
ble-sabbrev 'gupv=git pull --rebase -v'
ble-sabbrev 'gupa=git pull --rebase --autostash'
ble-sabbrev 'gupav=git pull --rebase --autostash -v'
ble-sabbrev 'gwch=git whatchanged -p --abbrev-commit --pretty=medium'
ble-sabbrev 'gco=git checkout'
ble-sabbrev 'gcb=git checkout -b'
ble-sabbrev 'gcod=git checkout develop'
ble-sabbrev 'gcom=git checkout $(git_default_branch)'
ble-sabbrev 'gfb=git flow bugfix'
ble-sabbrev 'gff=git flow feature'
ble-sabbrev 'gfr=git flow release'
ble-sabbrev 'gfh=git flow hotfix'
ble-sabbrev 'gfs=git flow support'
ble-sabbrev 'gfbs=git flow bugfix start'
ble-sabbrev 'gffs=git flow feature start'
ble-sabbrev 'gfrs=git flow release start'
ble-sabbrev 'gfhs=git flow hotfix start'
