# ble.sh interactive behavior and fzf integration.
bleopt complete_auto_complete=1
bleopt complete_auto_delay=250
bleopt history_share=1

if command -v fzf &> /dev/null; then
    ble-import integration/fzf-completion
    ble-import integration/fzf-key-bindings
    ble-bind -m emacs -x C-f fzf-history-widget
fi

# Expand the Git shortcuts visibly when Space is pressed.
ble-sabbrev g=git
ble-sabbrev 'ga=git add'
ble-sabbrev 'gaa=git add --all'
ble-sabbrev 'gau=git add --update'
ble-sabbrev 'gapa=git add --patch'
ble-sabbrev 'gap=git apply'
ble-sabbrev 'gb=git branch -vv'
ble-sabbrev 'gba=git branch -a -v'
ble-sabbrev 'gban=git branch -a -v --no-merged'
ble-sabbrev 'gbd=git branch -d'
ble-sabbrev 'gbD=git branch -D'
ble-sabbrev 'ggsup=git branch --set-upstream-to=origin/$(git_current_branch)'
ble-sabbrev 'gbl=git blame -b -w'
ble-sabbrev 'gbs=git bisect'
ble-sabbrev 'gbsb=git bisect bad'
ble-sabbrev 'gbsg=git bisect good'
ble-sabbrev 'gbsr=git bisect reset'
ble-sabbrev 'gbss=git bisect start'
ble-sabbrev 'gc=git commit -v'
ble-sabbrev 'gc!=git commit -v --amend'
ble-sabbrev 'gcn!=git commit -v --no-edit --amend'
ble-sabbrev 'gca=git commit -v -a'
ble-sabbrev 'gca!=git commit -v -a --amend'
ble-sabbrev 'gcan!=git commit -v -a --no-edit --amend'
ble-sabbrev 'gcv=git commit -v --no-verify'
ble-sabbrev 'gcav=git commit -a -v --no-verify'
ble-sabbrev 'gcav!=git commit -a -v --no-verify --amend'
ble-sabbrev 'gcm=git commit -m'
ble-sabbrev 'gcam=git commit -a -m'
ble-sabbrev 'gcs=git commit -S'
ble-sabbrev 'gscam=git commit -S -a -m'
ble-sabbrev 'gcfx=git commit --fixup'
ble-sabbrev 'gcf=git config --list'
ble-sabbrev 'gcl=git clone'
ble-sabbrev 'gclean=git clean -di'
ble-sabbrev 'gclean!=git clean -dfx'
ble-sabbrev 'gclean!!=git reset --hard && git clean -dfx'
ble-sabbrev 'gcount=git shortlog -sn'
ble-sabbrev 'gcp=git cherry-pick'
ble-sabbrev 'gcpa=git cherry-pick --abort'
ble-sabbrev 'gcpc=git cherry-pick --continue'
ble-sabbrev 'gd=git diff'
ble-sabbrev 'gdca=git diff --cached'
ble-sabbrev 'gds=git diff --stat'
ble-sabbrev 'gdsc=git diff --stat --cached'
ble-sabbrev 'gdt=git diff-tree --no-commit-id --name-only -r'
ble-sabbrev 'gdw=git diff --word-diff'
ble-sabbrev 'gdwc=git diff --word-diff --cached'
ble-sabbrev 'gdto=git difftool'
ble-sabbrev 'gdg=git diff --no-ext-diff'
ble-sabbrev 'gignore=git update-index --assume-unchanged'
ble-sabbrev 'gf=git fetch'
ble-sabbrev 'gfa=git fetch --all --prune'
ble-sabbrev 'gfm=git fetch origin $(git_default_branch) --prune && git merge FETCH_HEAD'
ble-sabbrev 'gfo=git fetch origin'
ble-sabbrev 'gl=git pull'
ble-sabbrev 'ggl=git pull origin $(git_current_branch)'
ble-sabbrev 'gll=git pull origin'
ble-sabbrev 'glr=git pull --rebase'
ble-sabbrev 'glg=git log --stat'
ble-sabbrev 'glgg=git log --graph'
ble-sabbrev 'glgga=git log --graph --decorate --all'
ble-sabbrev 'glo=git log --oneline --decorate --color'
ble-sabbrev 'glog=git log --oneline --decorate --color --graph'
ble-sabbrev 'gloga=git log --oneline --decorate --color --graph --all'
ble-sabbrev 'glom=git log --oneline --decorate --color $(git_default_branch)..'
ble-sabbrev 'glod=git log --oneline --decorate --color develop..'
ble-sabbrev 'gloo=git log --pretty=format:'"'"'%C(yellow)%h %Cred%ad %Cblue%an%Cgreen%d %Creset%s'"'"' --date=short'
ble-sabbrev 'gm=git merge'
ble-sabbrev 'gmt=git mergetool --no-prompt'
ble-sabbrev 'gmom=git merge origin/$(git_default_branch)'
ble-sabbrev 'gp=git push'
ble-sabbrev 'gp!=git push --force-with-lease'
ble-sabbrev 'gpo=git push origin'
ble-sabbrev 'gpo!=git push --force-with-lease origin'
ble-sabbrev 'gpfwl=git push --force-with-lease'
ble-sabbrev 'gpv=git push --no-verify'
ble-sabbrev 'gpv!=git push --no-verify --force-with-lease'
