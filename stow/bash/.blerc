ble-sabbrev 'gmr=git push origin $(git_current_branch) --set-upstream -o merge_request.create'
ble-sabbrev 'gmwps=git push origin $(git_current_branch) --set-upstream -o merge_request.create -o merge_request.merge_when_pipeline_succeeds'
ble-sabbrev 'groot=git rev-parse --show-toplevel'
ble-sabbrev 'gsw-=git switch -'
