{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "model": "opencode/gpt-5.6-sol",
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "settings": {
            "reasoningEffort": "medium",
            "textVerbosity": "low"
          }
        }
      }
    },
    "opencode": {
      "models": {
        "gpt-5.6-sol": {
          "settings": {
            "reasoningEffort": "medium",
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "RepoPromptCE": {
        "type": "local",
        "command": [
          "/Applications/RepoPrompt CE.app/Contents/MacOS/repoprompt-mcp"
        ],
        "disabled": false,
        "codemode": false,
        "timeout": {
          "catalog": 3600000,
          "execution": 3600000
        }
      },
      "ref": {
        "type": "remote",
        "url": "https://api.ref.tools/mcp?apiKey={env:REF_API_KEY}",
        "disabled": false,
        "timeout": {
          "catalog": 10000,
          "execution": 10000
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        },
        "disabled": false,
        "timeout": {
          "catalog": 10000,
          "execution": 10000
        }
      }
    }
  }
}
