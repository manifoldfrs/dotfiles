{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "paths": {
      "@earendil-works/pi-coding-agent": [
        "./node_modules/@earendil-works/pi-coding-agent"
      ],
      "@earendil-works/pi-ai": [
        "./node_modules/@earendil-works/pi-ai"
      ]
    }
  },
  "include": [
    "./pi_commands_test.ts",
    "../stow/pi/.pi/agent/extensions/jev-guardrails/*.ts",
    "../stow/pi/.pi/agent/extensions/lg.ts",
    "../stow/pi/.pi/agent/extensions/update.ts",
    "./pi_guardrails_test.ts",
    "./pi_compaction_test.ts",
    "../stow/pi/.pi/agent/extensions/agent-guardrails.ts",
    "../stow/pi/.pi/agent/extensions/continue-after-compaction.ts"
  ]
}
